@page
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Reportes";
    ViewData["ActiveMenu"] = "reportes";
    ViewData["ShellClass"] = "reports-shell";
}

<section class="reports-main">
    <div class="reports-workspace">
        <aside class="reports-modules" aria-label="Lista de reportes">
            <button class="active" type="button" data-report-module="commissions">Comisiones</button>
            <button type="button" data-report-module="payment-lots">Pagos generados</button>
            <button type="button" data-report-module="shipping">Envio de pedidos</button>
            <button type="button" data-report-module="customer-debt">Cliente estado pago</button>
            <button type="button" data-report-module="management-summary">Resumen gerencial</button>
        </aside>

        @await Html.PartialAsync("_ReporteComisiones")
        @await Html.PartialAsync("_ReportePagosGenerados")
        @await Html.PartialAsync("_ReporteEnvioPedidos")
        @await Html.PartialAsync("_ReporteResumenGerencial")
        @await Html.PartialAsync("_ReporteClientesDeuda")
    </div>
</section>

@section Scripts {
    <script>
        const dateFromInput = document.getElementById("date-from");
        const dateToInput = document.getElementById("date-to");
        const profileFilter = document.getElementById("profile-filter");
        const sellerFilter = document.getElementById("seller-filter");

        const summaryHost = document.getElementById("seller-summary");
        const commissionsTitle = document.getElementById("commissions-title");
        const commissionsDescription = document.getElementById("commissions-description");
        const paymentLotsBody = document.getElementById("payment-lots-body");
        const paymentLotsDateFromInput = document.getElementById("payment-lots-date-from");
        const paymentLotsDateToInput = document.getElementById("payment-lots-date-to");
        const paymentLotsStatusInput = document.getElementById("payment-lots-status");
        const paymentLotsPageSizeInput = document.getElementById("payment-lots-page-size");
        const paymentLotsPagination = document.getElementById("payment-lots-pagination");
        const shippingSummary = document.getElementById("shipping-summary");
        const shippingDetailBody = document.getElementById("shipping-detail-body");
        const shippingDateFromInput = document.getElementById("shipping-date-from");
        const shippingDateToInput = document.getElementById("shipping-date-to");
        const shippingClientInput = document.getElementById("shipping-client");
        const shippingMethodInput = document.getElementById("shipping-method");
        const managementDateFromInput = document.getElementById("management-date-from");
        const managementDateToInput = document.getElementById("management-date-to");
        const managementKpis = document.getElementById("management-kpis");
        const managementProductBody = document.getElementById("management-product-body");
        const managementMachineBody = document.getElementById("management-machine-body");
        const managementCommissionsBody = document.getElementById("management-commissions-body");
        const debtDateFromInput = document.getElementById("debt-date-from");
        const debtDateToInput = document.getElementById("debt-date-to");
        const debtClientInput = document.getElementById("debt-client");
        const debtStatusInput = document.getElementById("debt-status");
        const debtPaymentMethodInput = document.getElementById("debt-payment-method");
        const debtSellerInput = document.getElementById("debt-seller");
        const customerDebtKpis = document.getElementById("customer-debt-kpis");
        const customerDebtBody = document.getElementById("customer-debt-body");
        const sellerUserNames = new Map();
        let reportCommissionOptions = { perfiles: [], usuarios: [], teamLeaders: [] };
        let paymentLots = [];
        let paymentLotsPage = 1;
        let paymentLotsTotalPages = 1;
        let paymentLotsTotalItems = 0;

        function localDateValue(date = new Date()) {
            const offsetDate = new Date(date.getTime() - date.getTimezoneOffset() * 60000);
            return offsetDate.toISOString().slice(0, 10);
        }

        function localDateTimeFileValue(date = new Date()) {
            const offsetDate = new Date(date.getTime() - date.getTimezoneOffset() * 60000);
            return offsetDate.toISOString().slice(0, 16).replaceAll("-", "").replace("T", "").replace(":", "");
        }

        function fileSafeName(value) {
            return String(value || "vendedor")
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "")
                .replace(/[^a-zA-Z0-9]+/g, "-")
                .replace(/^-+|-+$/g, "")
                .toLowerCase() || "vendedor";
        }

        function firstNameFirstSurname(value) {
            const parts = String(value || "").trim().split(/\s+/).filter(Boolean);
            if (parts.length >= 3) {
                return `${parts[0]} ${parts[2]}`;
            }

            if (parts.length >= 2) {
                return `${parts[0]} ${parts[1]}`;
            }

            return parts[0] || "vendedor";
        }


        function monthStartValue() {
            const now = new Date();
            return localDateValue(new Date(now.getFullYear(), now.getMonth(), 1));
        }

        function formatMoney(value) {
            return `Gs. ${Number(value || 0).toLocaleString("es-PY", { maximumFractionDigits: 0 })}`;
        }

        function formatDate(value) {
            if (!value) {
                return "";
            }

            return new Date(value).toLocaleDateString("es-PY");
        }

        function formatDateTime(value) {
            if (!value) {
                return "";
            }

            return new Date(value).toLocaleString("es-PY", { dateStyle: "short", timeStyle: "short" });
        }

        function calculateSellerCommission(seller) {
            const details = seller.detalles || [];
            if (!details.length) {
                return Number(seller.totalComision || 0);
            }

            return details.reduce((total, detail) => total + Number(detail.comisionTotal || 0), 0);
        }

        function escapeHtml(value) {
            return String(value ?? "").replace(/[&<>"']/g, character => ({
                "&": "&amp;",
                "<": "&lt;",
                ">": "&gt;",
                "\"": "&quot;",
                "'": "&#039;"
            })[character]);
        }

        function selectedCommissionScope() {
            const profileName = profileFilter.selectedOptions[0]?.textContent || "";
            if (profileName.toLocaleLowerCase("es").includes("extern")) {
                return "externos";
            }

            return profileName.toLocaleLowerCase("es").includes("team leader")
                ? "team-leaders"
                : "";
        }

        function buildParams() {
            const params = new URLSearchParams();
            if (dateFromInput.value) {
                params.set("dateFrom", dateFromInput.value);
            }

            if (dateToInput.value) {
                params.set("dateTo", dateToInput.value);
            }

            if (sellerFilter.value) {
                params.set("vendedorId", sellerFilter.value);
            }

            if (profileFilter.value) {
                params.set("perfilId", profileFilter.value);
            }

            const scope = selectedCommissionScope();
            if (scope) {
                params.set("scope", scope);
            }
            return params;
        }

        function buildShippingParams() {
            const params = new URLSearchParams();
            if (shippingDateFromInput.value) {
                params.set("dateFrom", shippingDateFromInput.value);
            }

            if (shippingDateToInput.value) {
                params.set("dateTo", shippingDateToInput.value);
            }

            if (shippingClientInput.value.trim()) {
                params.set("cliente", shippingClientInput.value.trim());
            }

            if (shippingMethodInput.value) {
                params.set("metodoEntrega", shippingMethodInput.value);
            }

            return params;
        }

        function buildPaymentLotsParams() {
            const params = new URLSearchParams();
            if (paymentLotsDateFromInput.value) {
                params.set("dateFrom", paymentLotsDateFromInput.value);
            }

            if (paymentLotsDateToInput.value) {
                params.set("dateTo", paymentLotsDateToInput.value);
            }

            if (paymentLotsStatusInput.value) {
                params.set("estado", paymentLotsStatusInput.value);
            }

            params.set("page", paymentLotsPage);
            params.set("pageSize", paymentLotsPageSizeInput.value || "10");
            return params;
        }

        function buildManagementParams() {
            const params = new URLSearchParams();
            if (managementDateFromInput.value) {
                params.set("dateFrom", managementDateFromInput.value);
            }

            if (managementDateToInput.value) {
                params.set("dateTo", managementDateToInput.value);
            }

            return params;
        }

        function buildCustomerDebtParams() {
            const params = new URLSearchParams();
            if (debtDateFromInput.value) params.set("dateFrom", debtDateFromInput.value);
            if (debtDateToInput.value) params.set("dateTo", debtDateToInput.value);
            if (debtClientInput.value.trim()) params.set("cliente", debtClientInput.value.trim());
            if (debtStatusInput.value) params.set("estadoPago", debtStatusInput.value);
            if (debtPaymentMethodInput.value) params.set("formaPagoId", debtPaymentMethodInput.value);
            if (debtSellerInput.value) params.set("vendedorId", debtSellerInput.value);
            return params;
        }

        async function loadCustomerDebtReport() {
            await withAppLoading("Cargando ventas de clientes...", async function () {
                const response = await fetch(`/api/reportes/clientes-deuda?${buildCustomerDebtParams().toString()}`);
                if (!response.ok) {
                    const error = await response.json().catch(() => null);
                    showToast(error?.message || "No se pudo cargar el reporte de ventas de clientes.", "error");
                    return;
                }
                renderCustomerDebtReport(await response.json());
            });
        }
        async function loadOptions() {
            const response = await fetch("/api/reportes/opciones");
            if (!response.ok) {
                showToast("No se pudieron cargar las opciones de reportes.", "error");
                return;
            }

            const options = await response.json();
            reportCommissionOptions = {
                perfiles: options.perfilesVenta || [],
                usuarios: options.usuariosVenta || [],
                teamLeaders: options.teamLeaders || []
            };
            sellerUserNames.clear();
            reportCommissionOptions.usuarios.forEach(seller => {
                sellerUserNames.set(String(seller.id), seller.nombreUsuario || seller.persona || `vendedor-${seller.id}`);
            });

            profileFilter.innerHTML = reportCommissionOptions.perfiles
                .map(perfil => `<option value="${perfil.id}">${escapeHtml(perfil.nombre)}</option>`)
                .join("");

            const salesProfile = reportCommissionOptions.perfiles.find(perfil =>
                String(perfil.nombre || "").trim().toLocaleLowerCase("es") === "ventas");
            if (salesProfile) {
                profileFilter.value = String(salesProfile.id);
            }
            renderSellerFilter();
            debtPaymentMethodInput.innerHTML = `<option value="">Todas</option>` + (options.formasPago || [])
                .map(method => `<option value="${escapeHtml(method.id)}">${escapeHtml(method.nombre || method.id)}</option>`)
                .join("");
            debtSellerInput.innerHTML = `<option value="">Todos</option>` + (options.vendedoresTodos || [])
                .map(seller => `<option value="${seller.id}">${escapeHtml(seller.persona || seller.nombreUsuario || `Usuario ${seller.id}`)}</option>`)
                .join("");
        }

        function renderSellerFilter() {
            const profileId = Number(profileFilter.value || 0);
            const scope = selectedCommissionScope();
            const sellers = scope === "externos" || scope === "team-leaders"
                ? reportCommissionOptions.teamLeaders
                : reportCommissionOptions.usuarios
                    .filter(seller => !profileId || (seller.perfilIds || []).map(Number).includes(profileId));

            sellerFilter.innerHTML = [`<option value="">Todos</option>`]
                .concat(sellers.map(seller => `<option value="${seller.id}">${escapeHtml(seller.persona || seller.nombreUsuario || `Usuario ${seller.id}`)}</option>`))
                .join("");
        }

        async function loadReport() {
            await withAppLoading("Cargando reporte...", async function () {
                const response = await fetch(`/api/reportes/comisiones-vendedores?${buildParams().toString()}`);
                if (!response.ok) {
                    const error = await response.json().catch(() => null);
                    showToast(error?.message || "No se pudo cargar el reporte.", "error");
                    return;
                }

                renderReport(await response.json());
            });
        }

        async function loadPaymentLots() {
            await withAppLoading("Cargando lotes...", async function () {
                const params = buildPaymentLotsParams();
                const query = params.toString();
                const response = await fetch(`/api/reportes/lotes-pago${query ? `?${query}` : ""}`);
                if (!response.ok) {
                    const error = await response.json().catch(() => null);
                    showToast(error?.message || "No se pudieron cargar los lotes.", "error");
                    return;
                }

                const result = await response.json();
                paymentLots = result.items || [];
                paymentLotsPage = result.page || paymentLotsPage;
                paymentLotsTotalPages = Math.max(result.totalPages || 1, 1);
                paymentLotsTotalItems = result.totalItems || 0;
                renderPaymentLots();
            });
        }

        async function loadShippingReport() {
            await withAppLoading("Cargando reporte de envios...", async function () {
                const response = await fetch(`/api/reportes/envios?${buildShippingParams().toString()}`);
                if (!response.ok) {
                    const error = await response.json().catch(() => null);
                    showToast(error?.message || "No se pudo cargar el reporte de envios.", "error");
                    return;
                }

                renderShippingReport(await response.json());
            });
        }

        async function loadManagementSummary() {
            await withAppLoading("Cargando resumen gerencial...", async function () {
                const response = await fetch(`/api/reportes/resumen-gerencial?${buildManagementParams().toString()}`);
                if (!response.ok) {
                    const error = await response.json().catch(() => null);
                    showToast(error?.message || "No se pudo cargar el resumen gerencial.", "error");
                    return;
                }

                renderManagementSummary(await response.json());
            });
        }

        function renderTeamLeaderSales(seller) {
            const details = (seller.detalles || []).filter(detail => detail.vendedorOrigen);
            if (!details.length) {
                return "";
            }

            const salesBySeller = details.reduce((groups, detail) => {
                const sellerKey = String(detail.vendedorOrigenId || detail.vendedorOrigen || "sin-vendedor");
                (groups[sellerKey] ||= []).push(detail);
                return groups;
            }, {});

            return `<div class="team-leader-sales">${Object.values(salesBySeller).map(sales => {
                const sellerName = sales[0]?.vendedorOrigen || "Sin vendedor";
                const externalSellerId = sales[0]?.vendedorOrigenId;
                const orderCount = new Set(sales.map(sale => sale.pedidoId)).size;
                const totalSales = sales.reduce((sum, sale) => sum + Number(sale.totalDetalle || 0), 0);
                const totalCommission = sales.reduce((sum, sale) => sum + Number(sale.comisionTotal || 0), 0);
                return `<details class="team-leader-seller-accordion">
                    <summary>
                        <span class="team-leader-accordion-icon" aria-hidden="true"></span>
                        <strong>${escapeHtml(sellerName)}</strong>
                        <small>${orderCount} pedidos</small>
                        <small>${formatMoney(totalSales)} vendidos</small>
                        <small>${formatMoney(totalCommission)} comisión</small>
                        ${selectedCommissionScope() === "externos" && externalSellerId ? `
                            <button class="external-seller-download" type="button"
                                data-external-seller-id="${externalSellerId}"
                                data-external-seller-name="${escapeHtml(sellerName)}"
                                data-team-leader-id="${seller.vendedorId}"
                                title="Descargar ventas de ${escapeHtml(sellerName)}">PDF</button>` : ""}
                    </summary>
                    <div class="team-leader-sales-table-wrap">
                        <table class="team-leader-sales-table">
                            <thead><tr><th>Pedido</th><th>Fecha</th><th>Cliente</th><th>Producto</th><th>Cantidad</th><th>Total venta</th><th>Comisión</th></tr></thead>
                            <tbody>${sales.map(sale => `<tr>
                                <td>#${sale.pedidoId}</td>
                                <td>${formatDate(sale.fecha)}</td>
                                <td>${escapeHtml(sale.cliente)}</td>
                                <td>${escapeHtml(sale.producto)}</td>
                                <td>${Number(sale.cantidad || 0).toLocaleString("es-PY", { maximumFractionDigits: 2 })}</td>
                                <td>${formatMoney(sale.totalDetalle)}</td>
                                <td>${formatMoney(sale.comisionTotal)}</td>
                            </tr>`).join("")}</tbody>
                        </table>
                    </div>
                </details>`;
            }).join("")}</div>`;
        }
        function renderReport(report) {
            const sellers = [...(report.vendedores || [])]
                .sort((left, right) =>
                    calculateSellerCommission(right) - calculateSellerCommission(left)
                    || String(left.vendedor || "").localeCompare(String(right.vendedor || ""), "es"));
            summaryHost.innerHTML = sellers.length
                ? sellers.map(seller => `
                    <article class="${(seller.detalles || []).some(detail => detail.vendedorOrigen) ? "has-team-details" : ""}">
                        <div class="reports-card-heading">
                            <div class="reports-card-info">
                            <span>${escapeHtml(seller.vendedor)}</span>
                            <strong>${formatMoney(calculateSellerCommission(seller))}</strong>
                            <small>${seller.cantidadPedidos} pedidos - ${formatMoney(seller.totalVenta)}</small>
                        </div>
                            ${selectedCommissionScope() !== "externos" ? `<div class="reports-card-actions">
                            <button type="button" data-report-format="pdf" data-seller-id="${seller.vendedorId}" data-seller-name="${escapeHtml(seller.vendedor)}" title="Descargar PDF" aria-label="Descargar reporte PDF">
                                <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <path d="M14 2v6h6"></path>
                                    <path d="M8 13h1.5a1.5 1.5 0 0 1 0 3H8v-5"></path>
                                    <path d="M13 11v5h1a2.5 2.5 0 0 0 0-5z"></path>
                                    <path d="M17 11h3"></path>
                                    <path d="M17 13.5h2"></path>
                                    <path d="M17 16v-5"></path>
                                </svg>
                            </button>
                        </div>` : ""}
                        </div>
                        ${renderTeamLeaderSales(seller)}
                    </article>`).join("")
                : `<p>No hay ventas para los filtros seleccionados.</p>`;
        }

        function normalizeStatus(value) {
            return statusClass(value);
        }

        function renderPaymentLotsPagination() {
            paymentLotsPagination.innerHTML = `
                <span>Pagina ${paymentLotsPage} de ${paymentLotsTotalPages}</span>
                <div class="reports-pagination-actions">
                    <label>
                        <span>Registros</span>
                        <select id="payment-lots-page-size-control">
                            <option value="10" ${paymentLotsPageSizeInput.value === "10" ? "selected" : ""}>10</option>
                            <option value="20" ${paymentLotsPageSizeInput.value === "20" ? "selected" : ""}>20</option>
                            <option value="50" ${paymentLotsPageSizeInput.value === "50" ? "selected" : ""}>50</option>
                        </select>
                    </label>
                    <button type="button" data-payment-lots-page="previous" ${paymentLotsPage <= 1 ? "disabled" : ""}>Anterior</button>
                    <span class="reports-pagination-current">${paymentLotsPage}</span>
                    <button type="button" data-payment-lots-page="next" ${paymentLotsPage >= paymentLotsTotalPages ? "disabled" : ""}>Siguiente</button>
                </div>`;
        }

        function renderPaymentLots() {
            paymentLotsBody.innerHTML = paymentLots.length
                ? paymentLots.map(lot => `
                    <tr>
                        <td>${lot.id}</td>
                        <td>${formatDateTime(lot.fechaGeneracion)}</td>
                        <td>${formatDate(lot.fechaDesde)} al ${formatDate(lot.fechaHasta)}</td>
                        <td>${escapeHtml(lot.vendedor ? firstNameFirstSurname(lot.vendedor) : "Todos")}</td>
                        <td><strong>${escapeHtml(lot.perfil || "Sin especificar")}</strong></td>
                        <td>${lot.cantidadPersonas}</td>
                        <td>${formatMoney(lot.montoTotal)}</td>
                        <td><span class="reports-lot-status ${statusClass(lot.estado)}">${escapeHtml(lot.estado)}</span></td>
                        <td>
                            <div class="reports-row-actions">
                                <button type="button" data-lot-action="download" data-lot-id="${lot.id}">TXT</button>
                                <button type="button" data-lot-action="paid" data-lot-id="${lot.id}">Pagado</button>
                                <button type="button" data-lot-action="cancel" data-lot-id="${lot.id}">Anular</button>
                            </div>
                        </td>
                    </tr>`).join("")
                : `<tr><td colspan="9">No hay lotes para los filtros seleccionados.</td></tr>`;

            renderPaymentLotsPagination();
        }

        function renderShippingReport(report) {
            const resumen = report.resumen || [];
            const detalles = report.detalles || [];

            shippingSummary.innerHTML = resumen.length
                ? resumen.map(item => `
                    <article>
                        <div class="reports-card-info">
                            <span>${escapeHtml(item.usuarioEntrega)}</span>
                            <strong>${item.cantidadPedidos} envios</strong>
                            <small>${item.cantidadTransportadora} transportadora</small>
                            <small>Total pedidos ${formatMoney(item.totalPedidos)}</small>
                            <small>Comision delivery ${formatMoney(item.totalComisionDelivery)}</small>
                        </div>
                    </article>`).join("")
                : `<p>No hay envios para los filtros seleccionados.</p>`;

            shippingDetailBody.innerHTML = detalles.length
                ? detalles.map(item => `
                    <tr>
                        <td>${item.pedidoId}</td>
                        <td>${formatDate(item.fecha)}</td>
                        <td><strong>${escapeHtml(item.cliente)}</strong></td>
                        <td><span class="orders-status delivery-method ${statusClass(item.metodoEntrega)}">${escapeHtml(item.metodoEntrega)}</span></td>
                        <td><span class="reports-lot-status ${statusClass(item.estado)}">${escapeHtml(item.estado)}</span></td>
                        <td>${escapeHtml(item.usuarioEntrega || "-")}</td>
                        <td>${escapeHtml(item.ciudad || "-")}</td>
                        <td>${formatMoney(item.totalPedido)}</td>
                        <td>${formatMoney(item.comisionDelivery)}</td>
                    </tr>`).join("")
                : `<tr><td colspan="9">No hay pedidos para los filtros seleccionados.</td></tr>`;
        }

        function renderManagementSummary(report) {
            const productos = report.ventasPorProducto || [];
            const maquinas = report.ventasPorMaquina || [];
            const comisiones = report.comisionesPorPerfil || [];
            const totalNeto = Math.max(Number(report.totalVendido || 0) - Number(report.totalComisionPagada || 0), 0);

            managementKpis.innerHTML = `
                <article>
                    <div class="reports-card-info">
                        <span>Total vendido</span>
                        <strong>${formatMoney(report.totalVendido)}</strong>
                        <small>${report.cantidadPedidos || 0} pedidos</small>
                        <small>Promedio ${formatMoney(report.promedioPedido)}</small>
                    </div>
                </article>
                <article>
                    <div class="reports-card-info">
                        <span>Total neto</span>
                        <strong>${formatMoney(totalNeto)}</strong>
                        <small>Total vendido menos comision pagada</small>
                    </div>
                </article>
                <article>
                    <div class="reports-card-info">
                        <span>Total de comision pagado</span>
                        <strong>${formatMoney(report.totalComisionPagada)}</strong>
                        <small>${formatDate(report.fechaDesde)} al ${formatDate(report.fechaHasta)}</small>
                    </div>
                </article>`;

            managementProductBody.innerHTML = productos.length
                ? productos.map(item => `
                    <tr>
                        <td><strong>${escapeHtml(item.producto)}</strong></td>
                        <td>${item.cantidadPedidos}</td>
                        <td>${Number(item.cantidad || 0).toLocaleString("es-PY", { maximumFractionDigits: 2 })}</td>
                        <td>${formatMoney(item.totalVenta)}</td>
                    </tr>`).join("")
                : `<tr><td colspan="4">No hay ventas por producto para los filtros seleccionados.</td></tr>`;
            managementMachineBody.innerHTML = maquinas.length
                ? maquinas.map(item => `
                    <tr>
                        <td><strong>${escapeHtml(item.maquina)}</strong></td>
                        <td>${item.cantidadPedidos}</td>
                        <td>${Number(item.cantidad || 0).toLocaleString("es-PY", { maximumFractionDigits: 2 })}</td>
                        <td>${formatMoney(item.totalVenta)}</td>
                    </tr>`).join("")
                : `<tr><td colspan="4">No hay ventas por maquina para los filtros seleccionados.</td></tr>`;

            managementCommissionsBody.innerHTML = comisiones.length
                ? comisiones.map(item => `
                    <tr>
                        <td><strong>${escapeHtml(item.perfil)}</strong></td>
                        <td>${item.cantidadPedidos}</td>
                        <td>${formatMoney(item.totalVendido)}</td>
                        <td><strong>${formatMoney(item.totalPagado)}</strong></td>
                    </tr>`).join("")
                : `<tr><td colspan="4">No hay ventas ni pagos por perfil para los filtros seleccionados.</td></tr>`;
        }

        function statusClass(value) {
            return String(value || "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().replace(/\s+/g, "-");
        }

        async function downloadReport(format, sellerId, sellerName, externalSellerId) {
            await withAppLoading(`Preparando ${format.toUpperCase()}...`, async function () {
                const params = buildParams();
                if (sellerId) {
                    params.set("vendedorId", sellerId);
                }
                if (externalSellerId) {
                    params.set("vendedorExternoId", externalSellerId);
                }

                const response = await fetch(`/api/reportes/comisiones-vendedores/${format}?${params.toString()}`);
                if (!response.ok) {
                    const error = await response.json().catch(() => null);
                    showToast(error?.message || "No se pudo preparar el archivo.", "error");
                    return;
                }

                const blob = await response.blob();
                const link = document.createElement("a");
                link.href = URL.createObjectURL(blob);
                const extension = format === "pdf" ? "pdf" : format === "txt" ? "txt" : "xlsx";
                const fileName = format === "txt"
                    ? `banco-continental-comisiones-${localDateTimeFileValue()}.txt`
                    : `${fileSafeName(firstNameFirstSurname(sellerName))}-${localDateTimeFileValue()}.${extension}`;
                link.download = fileName;
                document.body.appendChild(link);
                link.click();
                link.remove();
                URL.revokeObjectURL(link.href);
            });
        }

        async function downloadLotTxt(lotId) {
            await withAppLoading("Descargando TXT...", async function () {
                const response = await fetch(`/api/reportes/lotes-pago/${lotId}/txt`);
                if (!response.ok) {
                    const error = await response.json().catch(() => null);
                    showToast(error?.message || "No se pudo descargar el lote.", "error");
                    return;
                }

                const blob = await response.blob();
                const link = document.createElement("a");
                link.href = URL.createObjectURL(blob);
                link.download = `lote-pago-${lotId}.txt`;
                document.body.appendChild(link);
                link.click();
                link.remove();
                URL.revokeObjectURL(link.href);
            });
        }

        async function updateLotStatus(lotId, estado) {
            await withAppLoading("Actualizando lote...", async function () {
                const response = await fetch(`/api/reportes/lotes-pago/${lotId}/estado`, {
                    method: "PUT",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ estado })
                });

                if (!response.ok) {
                    const error = await response.json().catch(() => null);
                    showToast(error?.message || "No se pudo actualizar el lote.", "error");
                    return;
                }

                showToast(`Lote marcado como ${estado}.`, "success");
                await loadPaymentLots();
            });
        }

        function setReportModule(module) {
            const isLots = module === "payment-lots";
            const isShipping = module === "shipping";
            const isManagement = module === "management-summary";
            const isCustomerDebt = module === "customer-debt";
            document.getElementById("commissions-panel").hidden = isLots || isShipping || isManagement || isCustomerDebt;
            document.getElementById("management-summary-panel").hidden = !isManagement;
            document.getElementById("shipping-panel").hidden = !isShipping;
            document.getElementById("payment-lots-panel").hidden = !isLots;
            document.getElementById("customer-debt-panel").hidden = !isCustomerDebt;
            document.querySelectorAll("[data-report-module]").forEach(button => {
                button.classList.toggle("active", button.dataset.reportModule === module);
            });

            if (isLots) {
                loadPaymentLots();
            } else if (isShipping) {
                loadShippingReport();
            } else if (isManagement) {
                loadManagementSummary();
            } else if (isCustomerDebt) {
                loadCustomerDebtReport();
            } else {
                commissionsTitle.textContent = "Reporte de comisiones";
                commissionsDescription.textContent = "Comisiones de todos los perfiles habilitados para vender.";
                sellerFilter.value = "";
                renderSellerFilter();
                loadReport();
            }
        }

        dateFromInput.value = monthStartValue();
        dateToInput.value = localDateValue();
        shippingDateFromInput.value = localDateValue();
        shippingDateToInput.value = localDateValue();
        managementDateFromInput.value = monthStartValue();
        managementDateToInput.value = localDateValue();
        paymentLotsDateFromInput.value = monthStartValue();
        paymentLotsDateToInput.value = localDateValue();
        debtDateFromInput.value = monthStartValue();
        debtDateToInput.value = localDateValue();

        let reportFilterTimer;
        function debounceReportFilter(callback) {
            window.clearTimeout(reportFilterTimer);
            reportFilterTimer = window.setTimeout(callback, 350);
        }

        [dateFromInput, dateToInput, sellerFilter].forEach(input => input.addEventListener("change", loadReport));

        profileFilter.addEventListener("change", () => {
            sellerFilter.value = "";
            renderSellerFilter();
            loadReport();
        });
        [shippingDateFromInput, shippingDateToInput, shippingMethodInput]
            .forEach(input => input.addEventListener("change", loadShippingReport));
        shippingClientInput.addEventListener("input", () => debounceReportFilter(loadShippingReport));
        [managementDateFromInput, managementDateToInput]
            .forEach(input => input.addEventListener("change", loadManagementSummary));
        [debtDateFromInput, debtDateToInput, debtStatusInput, debtPaymentMethodInput, debtSellerInput]
            .forEach(input => input.addEventListener("change", loadCustomerDebtReport));
        debtClientInput.addEventListener("input", () => debounceReportFilter(loadCustomerDebtReport));
        document.getElementById("download-bank-txt").addEventListener("click", () => downloadReport("txt", sellerFilter.value, sellerFilter.selectedOptions[0]?.textContent || "todos"));
        document.getElementById("refresh-payment-lots").addEventListener("click", loadPaymentLots);
        [paymentLotsDateFromInput, paymentLotsDateToInput].forEach(input => input.addEventListener("change", () => {
            paymentLotsPage = 1;
            loadPaymentLots();
        }));
        document.getElementById("clear-payment-lots").addEventListener("click", () => {
            paymentLotsDateFromInput.value = monthStartValue();
            paymentLotsDateToInput.value = localDateValue();
            paymentLotsStatusInput.value = "";
            paymentLotsPage = 1;
            loadPaymentLots();
        });
        paymentLotsStatusInput.addEventListener("change", () => {
            paymentLotsPage = 1;
            loadPaymentLots();
        });
        paymentLotsPageSizeInput.addEventListener("change", () => {
            paymentLotsPage = 1;
            loadPaymentLots();
        });
        paymentLotsPagination.addEventListener("click", event => {
            const button = event.target.closest("[data-payment-lots-page]");
            if (!button) {
                return;
            }

            paymentLotsPage += button.dataset.paymentLotsPage === "next" ? 1 : -1;
            loadPaymentLots();
        });
        paymentLotsPagination.addEventListener("change", event => {
            const select = event.target.closest("#payment-lots-page-size-control");
            if (!select) {
                return;
            }

            paymentLotsPageSizeInput.value = select.value;
            paymentLotsPage = 1;
            loadPaymentLots();
        });
        document.querySelectorAll("[data-report-module]").forEach(button => {
            button.addEventListener("click", () => setReportModule(button.dataset.reportModule));
        });
        paymentLotsBody.addEventListener("click", event => {
            const button = event.target.closest("[data-lot-action]");
            if (!button) {
                return;
            }

            const lotId = button.dataset.lotId;
            if (button.dataset.lotAction === "download") {
                downloadLotTxt(lotId);
            } else if (button.dataset.lotAction === "paid") {
                updateLotStatus(lotId, "Pagado");
            } else if (button.dataset.lotAction === "cancel") {
                updateLotStatus(lotId, "Anulado");
            }
        });
        summaryHost.addEventListener("click", event => {
            const externalSellerButton = event.target.closest("[data-external-seller-id]");
            if (externalSellerButton) {
                event.preventDefault();
                event.stopPropagation();
                downloadReport(
                    "pdf",
                    externalSellerButton.dataset.teamLeaderId,
                    externalSellerButton.dataset.externalSellerName,
                    externalSellerButton.dataset.externalSellerId);
                return;
            }

            const button = event.target.closest("[data-report-format]");
            if (!button) {
                return;
            }

            downloadReport(button.dataset.reportFormat, button.dataset.sellerId, button.dataset.sellerName);
        });

        loadOptions().then(loadReport);
    </script>
}
