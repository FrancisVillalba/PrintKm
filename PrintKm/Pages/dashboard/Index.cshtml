@page
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Dashboard";
    ViewData["ActiveMenu"] = "dashboard";
    ViewData["ShellClass"] = "dashboard-shell";
}

<section class="dashboard-main dashboard-analytics">
    <section class="dashboard-analytics-grid" aria-label="Resumen del sistema de impresiones">
        <article class="analytics-card machine-card">
            <header class="machine-card-header">
                <h2>Meta mensual de facturación por máquina</h2>
            </header>
            <section class="machine-overall" aria-label="Progreso general">
                <div class="machine-overall-label"><span>Progreso general</span><strong id="machine-total">0%</strong></div>
                <div class="machine-progress-track"><i id="machine-total-progress"></i></div>
            </section>
            <div class="machine-goals-grid" id="machine-goals-grid" aria-label="Metas mensuales por máquina"></div>
            <footer class="machine-card-footer">
                <span id="machine-period-caption">Facturación mensual contra metas configuradas</span>
            </footer>
        </article>

        <section class="summary-card-grid" aria-label="Estado operativo de pedidos">
            <article class="summary-tile tile-green dashboard-detail-trigger" data-dashboard-detail="carga" data-dashboard-title="Pedidos cargados hoy" data-stage="carga" role="button" tabindex="0">
                <span class="summary-icon"><svg viewBox="0 0 24 24"><path d="M7 3h7l4 4v14H7z"/><path d="M14 3v5h5M9 13h6M9 17h4"/></svg></span>
                <div><p>PEDIDOS CARGADOS HOY</p><strong id="metric-carga">0</strong><small id="metric-carga-today">0 movimientos hoy</small></div>
            </article>
            <article class="summary-tile tile-blue dashboard-detail-trigger" data-dashboard-detail="impresion" data-dashboard-title="Pedidos en impresión" data-stage="impresion" role="button" tabindex="0">
                <span class="summary-icon"><svg viewBox="0 0 24 24"><path d="M7 8V3h10v5M7 17H5a2 2 0 0 1-2-2v-4a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v4a2 2 0 0 1-2 2h-2M7 14h10v7H7z"/></svg></span>
                <div><p>EN IMPRESIÓN</p><strong id="metric-impresion">0</strong><small id="metric-impresion-today">0 movimientos hoy</small></div>
            </article>
            <article class="summary-tile tile-purple dashboard-detail-trigger" data-dashboard-detail="control" data-dashboard-title="Pedidos en control" data-stage="control" role="button" tabindex="0">
                <span class="summary-icon"><svg viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h4m-4 4 2 2 5-5"/></svg></span>
                <div><p>EN CONTROL</p><strong id="metric-control">0</strong><small id="metric-control-today">0 movimientos hoy</small></div>
            </article>
            <article class="summary-tile tile-orange dashboard-detail-trigger" data-dashboard-detail="pendiente-envio" data-dashboard-title="Pedidos pendientes de envío" data-stage="pendienteEnvio" role="button" tabindex="0">
                <span class="summary-icon"><svg viewBox="0 0 24 24"><path d="M12 7v5l4 2M21 12a9 9 0 1 1-9-9M12 3v3"/></svg></span>
                <div><p>PENDIENTES DE ENVÍO</p><strong id="metric-pendiente-envio">0</strong><small id="metric-pendiente-envio-today">0 movimientos hoy</small></div>
            </article>
            <article class="summary-tile tile-teal dashboard-detail-trigger" data-dashboard-detail="enviados" data-dashboard-title="Pedidos enviados hoy" data-stage="enviadosHoy" role="button" tabindex="0">
                <span class="summary-icon"><svg viewBox="0 0 24 24"><path d="M3 6h11v10H3zM14 10h4l3 3v3h-7zM7 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM18 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/></svg></span>
                <div><p>ENVIADOS HOY</p><strong id="metric-enviados">0</strong><small id="metric-enviados-today">Procesados durante el día</small></div>
            </article>
            <article class="summary-tile tile-red dashboard-detail-trigger" data-dashboard-detail="incidencias" data-dashboard-title="Pedidos rechazados o devueltos" data-stage="incidencias" role="button" tabindex="0">
                <span class="summary-icon"><svg viewBox="0 0 24 24"><path d="M12 3 2 21h20L12 3Z"/><path d="M12 9v5M12 18h.01"/></svg></span>
                <div><p>RECHAZADOS / DEVUELTOS</p><strong id="metric-incidencias">0</strong><small id="metric-incidencias-today">0 movimientos hoy</small></div>
            </article>
        </section>
        <article class="analytics-card bar-card">
            <header>
                <h2>Mejor vendedor del mes</h2>
            </header>
            <div class="bar-chart seller-chart" id="seller-bars"></div>
        </article>

        <article class="analytics-card bar-card">
            <header>
                <h2>Pendientes de pago</h2>
                <p class="bar-card-subtitle">Proporción del saldo pendiente</p>
            </header>
            <div class="bar-chart" id="payment-bars"></div>
        </article>
    </section>
</section>

<div id="dashboard-detail-modal" class="dashboard-detail-modal" hidden>
    <div class="dashboard-detail-backdrop" data-dashboard-close></div>
    <section class="dashboard-detail-dialog" role="dialog" aria-modal="true" aria-labelledby="dashboard-detail-title">
        <header>
            <div>
                <h2 id="dashboard-detail-title">Detalle de pedidos</h2>
                <p id="dashboard-detail-caption"></p>
            </div>
            <button id="dashboard-detail-close" type="button" aria-label="Cerrar">&times;</button>
        </header>
        <div id="dashboard-detail-summary" class="dashboard-detail-summary"></div>
        <div class="admin-table-wrap dashboard-detail-table-wrap">
            <table class="admin-table dashboard-detail-table">
                <thead><tr><th>Pedido</th><th>Fecha y hora</th><th>Cliente</th><th>Vendedor</th><th>Estado</th><th>Forma de pago</th><th>Entrega</th><th>Total</th><th>Pagado</th><th>Saldo</th><th>Acciones</th></tr></thead>
                <tbody id="dashboard-detail-body"></tbody>
            </table>
        </div>
    </section>
</div>

<div id="dashboard-order-form-modal" class="order-form-modal dashboard-order-form-modal" hidden>
    <div class="order-form-modal-backdrop" data-dashboard-order-close></div>
    <section class="order-form-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="dashboard-order-form-title">
        <header class="order-form-modal-header">
            <h2 id="dashboard-order-form-title">Venta</h2>
            <button id="dashboard-order-form-close" type="button" aria-label="Cerrar formulario">&times;</button>
        </header>
        <iframe id="dashboard-order-form-frame" title="Formulario de venta"></iframe>
    </section>
</div>

@section Scripts {
    <script>
        const chartColors = ["#38bdf8", "#0369a1", "#111827", "#7dd3fc", "#0284c7", "#475569", "#0c4a6e"];
        const detailModal = document.getElementById("dashboard-detail-modal");
        const detailTitle = document.getElementById("dashboard-detail-title");
        const detailCaption = document.getElementById("dashboard-detail-caption");
        const detailBody = document.getElementById("dashboard-detail-body");
        const detailSummary = document.getElementById("dashboard-detail-summary");
        const orderFormModal = document.getElementById("dashboard-order-form-modal");
        const orderFormFrame = document.getElementById("dashboard-order-form-frame");
        const orderFormTitle = document.getElementById("dashboard-order-form-title");
        let activeDetail = null;

        function escapeHtml(value) {
            return String(value ?? "").replace(/[&<>"']/g, character => ({
                "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#039;"
            })[character]);
        }

        function formatInteger(value) {
            return Number(value || 0).toLocaleString("es-PY");
        }

        function formatDecimal(value) {
            return Number(value || 0).toLocaleString("es-PY", { maximumFractionDigits: 2 });
        }

        function formatCompactMoney(value) {
            const number = Number(value || 0);
            if (Math.abs(number) >= 1000000) {
                return `${formatDecimal(number / 1000000)}M`;
            }

            return formatDecimal(number);
        }

        function renderTotalDonut(goal) {
            const target = Number(goal?.meta || 0);
            const percent = target > 0
                ? Math.max(Math.min(Number(goal?.porcentaje || 0), 100), 0)
                : 0;
            document.getElementById("machine-total").textContent = target > 0 ? `${Math.round(percent)}%` : "Sin meta";
            document.getElementById("machine-total-progress").style.width = `${percent}%`;
        }

        function renderGoalDonuts(items) {
            const container = document.getElementById("machine-goals-grid");
            const goals = items || [];

            if (!goals.length) {
                container.innerHTML = `<p class="empty-chart">No hay máquinas activas para mostrar</p>`;
                return;
            }

            container.innerHTML = goals.map((item, index) => {
                const percent = Math.max(Math.min(Number(item.porcentaje || 0), 100), 0);
                const color = chartColors[index % chartColors.length];
                const hasGoal = Number(item.meta || 0) > 0;
                const status = !hasGoal ? "Sin meta" : item.cumplido ? "Cumplida" : "Falta";
                const displayPercent = hasGoal ? `${Math.round(percent)}%` : "—";

                return `
                    <article class="machine-goal-row">
                        <span class="machine-goal-icon" style="--machine-color:${color}" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M7 8V3h10v5M7 17H5a2 2 0 0 1-2-2v-4a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v4a2 2 0 0 1-2 2h-2M7 14h10v7H7z"/></svg>
                        </span>
                        <h3 title="${escapeHtml(item.nombre)}">${escapeHtml(item.nombre)}</h3>
                        <div class="machine-progress-track"><i style="width:${percent}%; background:${color}"></i></div>
                        <strong class="machine-goal-percent">${displayPercent}</strong>
                        <span class="machine-goal-status ${item.cumplido ? "is-complete" : ""}">${status}</span>
                    </article>`;
            }).join("");
        }

        function renderBars(containerId, items, valueKey, limit) {
            const container = document.getElementById(containerId);
            const rows = (items || []).slice(0, limit);
            const max = Math.max(...rows.map(item => Number(item[valueKey] || 0)), 1);

            if (!rows.length) {
                container.innerHTML = `<p class="empty-chart">Sin datos para mostrar</p>`;
                return;
            }

            const isPayment = containerId === "payment-bars";
            container.innerHTML = rows.map((item, index) => {
                const value = Number(item[valueKey] || 0);
                const width = Math.max((value / max) * 100, 3);
                const name = escapeHtml(item.nombre);
                const initial = name.trim().charAt(0).toUpperCase() || "—";
                const marker = isPayment
                    ? `<span class="bar-avatar">${initial}</span>`
                    : `<span class="bar-rank">${index + 1}°</span>`;
                const label = isPayment
                    ? `<button type="button" class="dashboard-client-trigger" data-dashboard-client="${name}">${name}</button>`
                    : `<span class="bar-name" title="${name}">${name}</span>`;

                return `
                    <div class="bar-row">
                        ${marker}
                        ${label}
                        <div class="bar-track">
                            <i style="width:${width}%; background:${isPayment ? "#38bdf8" : chartColors[index % chartColors.length]}"></i>
                        </div>
                    </div>`;
            }).join("");
        }

        async function openDashboardDetail(tipo, title, cliente = "") {
            activeDetail = { tipo, title, cliente };
            const params = new URLSearchParams({ tipo });
            if (cliente) params.set("cliente", cliente);
            detailTitle.textContent = title;
            detailCaption.textContent = cliente ? `Cliente: ${cliente}` : "Ventas relacionadas con este indicador";
            detailSummary.innerHTML = "";
            detailBody.innerHTML = `<tr><td colspan="11" class="dashboard-detail-message">Cargando pedidos...</td></tr>`;
            detailModal.hidden = false;

            const response = await fetch(`/api/dashboard/pedidos?${params.toString()}`);
            if (!response.ok) {
                detailBody.innerHTML = `<tr><td colspan="11" class="dashboard-detail-message dashboard-detail-error">No se pudo cargar el detalle.</td></tr>`;
                return;
            }

            const rows = await response.json() || [];
            const total = rows.reduce((sum, row) => sum + Number(row.totalVenta || 0), 0);
            const pendiente = rows.reduce((sum, row) => sum + Number(row.saldoPendiente || 0), 0);
            detailSummary.innerHTML = `
                <div><span>Pedidos</span><strong>${formatInteger(rows.length)}</strong></div>
                <div><span>Total vendido</span><strong>Gs. ${formatInteger(total)}</strong></div>
                <div><span>Saldo pendiente</span><strong>Gs. ${formatInteger(pendiente)}</strong></div>`;
            detailBody.innerHTML = rows.length ? rows.map(row => `
                <tr>
                    <td><strong class="dashboard-order-number">#${row.id}</strong></td>
                    <td><span class="dashboard-date">${new Date(row.fecha).toLocaleDateString("es-PY")}</span><small>${new Date(row.fecha).toLocaleTimeString("es-PY", { hour: "2-digit", minute: "2-digit" })}</small></td>
                    <td><strong>${escapeHtml(row.cliente)}</strong></td>
                    <td>${escapeHtml(row.vendedor)}</td>
                    <td><span class="dashboard-status">${escapeHtml(row.estado)}</span></td>
                    <td>${escapeHtml(row.formaPago)}</td>
                    <td>${escapeHtml(row.metodoEntrega)}</td>
                    <td class="dashboard-money">Gs. ${formatInteger(row.totalVenta)}</td>
                    <td class="dashboard-money dashboard-money-paid">Gs. ${formatInteger(row.montoPagado)}</td>
                    <td class="dashboard-money ${Number(row.saldoPendiente || 0) > 0 ? "dashboard-money-due" : "dashboard-money-zero"}">Gs. ${formatInteger(row.saldoPendiente)}</td>
                    <td><button type="button" class="orders-edit dashboard-order-open" data-dashboard-order-id="${row.id}">Ver venta</button></td>
                </tr>`).join("") : `<tr><td colspan="11" class="dashboard-detail-message">No hay pedidos para mostrar.</td></tr>`;
        }

        function openDashboardOrder(orderId) {
            orderFormTitle.textContent = `Venta ${orderId}`;
            orderFormFrame.src = `${window.appUrl("/pedidos/formulario")}?id=${encodeURIComponent(orderId)}&embedded=1`;
            orderFormModal.hidden = false;
            document.body.classList.add("is-order-modal-open");
            document.getElementById("dashboard-order-form-close").focus();
        }

        function closeDashboardOrder(shouldRefresh = false) {
            orderFormModal.hidden = true;
            orderFormFrame.src = "about:blank";
            document.body.classList.remove("is-order-modal-open");
            if (shouldRefresh) {
                loadDashboard();
                if (activeDetail) openDashboardDetail(activeDetail.tipo, activeDetail.title, activeDetail.cliente);
            }
        }

        function closeDashboardDetail() {
            detailModal.hidden = true;
        }

        document.addEventListener("click", event => {
            const metric = event.target.closest("[data-dashboard-detail]");
            if (metric) openDashboardDetail(metric.dataset.dashboardDetail, metric.dataset.dashboardTitle || "Detalle de pedidos");
            const client = event.target.closest("[data-dashboard-client]");
            if (client) openDashboardDetail("pendientes-pago", "Pedidos pendientes de pago", client.dataset.dashboardClient || "");
            const order = event.target.closest("[data-dashboard-order-id]");
            if (order) openDashboardOrder(order.dataset.dashboardOrderId);
            if (event.target.closest("[data-dashboard-close]")) closeDashboardDetail();
            if (event.target.closest("[data-dashboard-order-close]")) closeDashboardOrder();
        });
        document.addEventListener("keydown", event => {
            if ((event.key === "Enter" || event.key === " ") && event.target.matches("[data-dashboard-detail]")) event.target.click();
            if (event.key === "Escape" && !orderFormModal.hidden) {
                closeDashboardOrder();
            } else if (event.key === "Escape" && !detailModal.hidden) {
                closeDashboardDetail();
            }
        });
        document.getElementById("dashboard-detail-close").addEventListener("click", closeDashboardDetail);
        document.getElementById("dashboard-order-form-close").addEventListener("click", () => closeDashboardOrder());
        window.addEventListener("message", function (event) {
            if (event.origin !== window.location.origin) return;
            if (event.data?.type === "order-modal-close") closeDashboardOrder();
            if (event.data?.type === "order-modal-saved") closeDashboardOrder(true);
        });

        function renderStage(stageKey, totalId, todayId, data) {
            data = data || {};
            document.getElementById(totalId).textContent = formatInteger(data.total);
            document.getElementById(todayId).textContent = `${formatInteger(data.movimientosHoy)} movimientos hoy`;
            const card = document.querySelector(`[data-stage="${stageKey}"]`);
            card?.classList.toggle("stage-warning", Number(data.demorados24 || 0) > 0);
            card?.classList.toggle("stage-danger", Number(data.demorados48 || 0) > 0);
            const delayed = Number(data.demorados48 || 0) || Number(data.demorados24 || 0);
            card?.setAttribute("title", delayed > 0 ? `${delayed} pedido(s) con demora` : "Sin demoras");
        }
        async function loadDashboard() {
            const response = await fetch("/api/dashboard");

            if (!response.ok) {
                showToast("No se pudo cargar el dashboard. Verifique que la API EvaluSystemBack este levantada y que haya iniciado sesion.", "error");
                return;
            }

            const dashboard = await response.json();
            const machineGoals = dashboard.metasMensualesPorMaquina || [];
            const totalGoal = dashboard.metaMensualTotal || {};
            const monthLabel = new Date().toLocaleDateString("es-PY", { month: "long", year: "numeric" });

            renderStage("carga", "metric-carga", "metric-carga-today", dashboard.carga);
            renderStage("impresion", "metric-impresion", "metric-impresion-today", dashboard.impresion);
            renderStage("control", "metric-control", "metric-control-today", dashboard.control);
            renderStage("pendienteEnvio", "metric-pendiente-envio", "metric-pendiente-envio-today", dashboard.pendienteEnvio);
            renderStage("enviadosHoy", "metric-enviados", "metric-enviados-today", dashboard.enviadosHoy);
            renderStage("incidencias", "metric-incidencias", "metric-incidencias-today", dashboard.incidencias);
            document.getElementById("machine-period-caption").textContent = `Facturación de ${monthLabel} contra metas configuradas`;

            renderTotalDonut(totalGoal);
            renderGoalDonuts(machineGoals);
            renderBars("payment-bars", dashboard.pendientesPago || [], "monto", 13);
            renderBars("seller-bars", dashboard.mejoresVendedores || [], "monto", 10);
        }

        loadDashboard();
    </script>
}
