@page
@{
    Layout = null;
    ViewData["Title"] = "PrintKm";
}

<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="app-base-path" content="@Url.Content("~/")" />
    <title>PrintKm</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/index-Cio5xgoS.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/printkm-theme.css" asp-append-version="true" />
</head>
<body>
    <div id="toast-host" class="toast-host" aria-live="polite" aria-atomic="true"></div>
    <main id="app" class="login-page">
        <section class="brand-panel" aria-label="Resumen de PrintKm">
            <div class="brand-logo" aria-label="PrintKm">
                <img class="printkm-logo" src="~/assets/printkm-logo-v4.png" alt="PrintKM" asp-append-version="true" width="2172" height="724" />
            </div>

            <div class="brand-copy">
                <p class="eyebrow">Panel de produccion</p>
                <h1>Pedidos, vendedores e impresion en un solo tablero.</h1>
            </div>
        </section>

        <section class="login-panel" aria-label="Inicio de sesion">
            <div class="form-heading">
                <p class="eyebrow">Bienvenido de vuelta</p>
                <h2>Iniciar sesion</h2>
                <p>Ingresa tus credenciales para continuar.</p>
            </div>

            <form id="login-form" class="login-form">
                <label for="usuario">
                    Usuario
                    <input id="usuario" name="usuario" type="text" placeholder="Ingresa tu usuario" autocomplete="username" />
                </label>

                <label for="password">
                    Contrasena
                    <input id="password" name="password" type="password" placeholder="Ingresa tu contrasena" autocomplete="current-password" />
                </label>

                <div class="form-options">
                    <label class="remember" for="remember">
                        <input id="remember" name="remember" type="checkbox" />
                        Recordarme
                    </label>
@*                     <a href="#recuperar">Olvide mi contrasena</a>
 *@                </div>

                <button type="submit">Ingresar</button>
            </form>
        </section>
    </main>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        const rememberedUserKey = "evaluSystem.rememberedUser";
        const usuarioInput = document.getElementById("usuario");
        const passwordInput = document.getElementById("password");
        const rememberInput = document.getElementById("remember");
        const rememberedUser = localStorage.getItem(rememberedUserKey);

        if (rememberedUser) {
            usuarioInput.value = rememberedUser;
            rememberInput.checked = true;
            passwordInput.focus();
        }

        document.getElementById("login-form").addEventListener("submit", async function (event) {
            event.preventDefault();

            let response;
            const usuario = usuarioInput.value.trim();

            try {
                response = await withAppLoading("Iniciando sesion...", async function () {
                    return await fetch("/api/auth/login", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({
                            usuario: usuario,
                            pass: passwordInput.value
                        })
                    });
                });
            } catch {
                showToast("No se pudo conectar con el back. Verifique que la API este abierta.", "error");
                return;
            }

            if (!response.ok) {
                let message = "No se pudo iniciar sesion. Verifique usuario, contrasena y que la API este levantada.";

                try {
                    const error = await response.json();
                    message = error.message || message;
                } catch {
                    // Keep the default message when the server response is not JSON.
                }

                showToast(message, "error");
                return;
            }

            if (rememberInput.checked) {
                localStorage.setItem(rememberedUserKey, usuario);
            } else {
                localStorage.removeItem(rememberedUserKey);
            }

            let loginData = {};
            try {
                loginData = await response.json();
            } catch {
                loginData = {};
            }

            showToast("Inicio de sesion correcto.", "success");
            window.setTimeout(() => {
                window.navigateToApp(loginData.redirectUrl || "/dashboard");
            }, 600);
        });
    </script>
</body>
</html>
