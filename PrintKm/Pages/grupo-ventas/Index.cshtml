@page
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Grupo de ventas";
    ViewData["ActiveMenu"] = "grupo-ventas";
    ViewData["ShellClass"] = "reports-shell";
}

@section Styles {
    <link rel="stylesheet" href="~/css/control.css" asp-append-version="true" />
}

<section class="reports-main">
    <section class="team-sales-panel">
        <div class="orders-panel-heading">
            <div>
                <h2>Ventas externas</h2>
                <p id="team-sales-count">0 ventas encontradas</p>
            </div>
            <button id="download-team-sales-excel" class="orders-export" type="button">Excel</button>
        </div>

        <div class="team-sales-filters">
            <label>Desde<input id="team-date-from" type="date" /></label>
            <label>Hasta<input id="team-date-to" type="date" /></label>
            <label>Vendedor externo<select id="team-seller-filter"><option value="">Todos</option></select></label>
            <label>Cliente<select id="team-client-filter"><option value="">Todos</option></select></label>
            <label>Estado de pago<select id="team-payment-status-filter"><option value="">Todos</option></select></label>
        </div>

        <div class="team-sales-tabs">
            <button class="active" type="button" data-tab="summary">Resumen</button>
            <button type="button" data-tab="sales">Ventas</button>
        </div>

        <section id="team-summary-tab" class="team-sales-tab-panel">
            <div id="team-summary-chart" class="team-summary-chart"></div>
        </section>

        <section id="team-sales-tab" class="team-sales-tab-panel" hidden>
            <div class="admin-table-wrap">
                <table class="admin-table team-sales-table">
                    <thead>
                        <tr>
                            <th>Pedido</th>
                            <th>Fecha</th>
                            <th>Vendedor</th>
                            <th>Cliente</th>
                            <th>Estado</th>
                            <th>Usuario entrega</th>
                            <th>Total venta</th>
                            <th>Total pagado</th>
                            <th>Metros</th>
                            <th>Total comision</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="team-sales-body"></tbody>
                    <tfoot id="team-sales-foot"></tfoot>
                </table>
            </div>
            <div class="team-sales-pagination">
                <span id="team-sales-page-info">Pagina 1 de 1</span>
                <div>
                    <label>Registros
                        <select id="team-sales-page-size">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                    </label>
                    <button id="team-sales-prev" type="button">Anterior</button>
                    <strong id="team-sales-page-number">1</strong>
                    <button id="team-sales-next" type="button">Siguiente</button>
                </div>
            </div>
        </section>
    </section>
</section>

<div id="team-order-form-modal" class="order-form-modal" hidden>
    <div class="order-form-modal-backdrop" data-team-order-modal-close></div>
    <section class="order-form-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="team-order-form-modal-title">
        <header class="order-form-modal-header">
            <h2 id="team-order-form-modal-title">Pedido</h2>
            <button id="team-order-form-modal-close" type="button" aria-label="Cerrar formulario">&times;</button>
        </header>
        <iframe id="team-order-form-frame" title="Formulario de pedido"></iframe>
    </section>
</div>
<div id="team-flow-modal" class="control-modal" hidden>
    <section class="control-modal-card order-flow-modal-card" role="dialog" aria-modal="true" aria-labelledby="team-flow-title">
        <header>
            <div><span>Historial completo</span><h2 id="team-flow-title">Flujo del pedido</h2></div>
            <button id="team-flow-close" class="control-modal-close" type="button" aria-label="Cerrar">&times;</button>
        </header>
        <div id="team-flow-content" class="order-flow-timeline"></div>
        <footer><button id="team-flow-close-footer" class="admin-secondary" type="button">Cerrar</button></footer>
    </section>
</div>
@section Scripts {
    <script>
        const dateFrom = document.getElementById("team-date-from");
        const dateTo = document.getElementById("team-date-to");
        const sellerFilter = document.getElementById("team-seller-filter");
        const clientFilter = document.getElementById("team-client-filter");
        const paymentStatusFilter = document.getElementById("team-payment-status-filter");
        const summaryChart = document.getElementById("team-summary-chart");
        const salesBody = document.getElementById("team-sales-body");
        const salesFoot = document.getElementById("team-sales-foot");
        const downloadExcelButton = document.getElementById("download-team-sales-excel");
        const pageSizeSelect = document.getElementById("team-sales-page-size");
        const prevPageButton = document.getElementById("team-sales-prev");
        const nextPageButton = document.getElementById("team-sales-next");
        const pageInfo = document.getElementById("team-sales-page-info");
        const pageNumber = document.getElementById("team-sales-page-number");
        const salesCount = document.getElementById("team-sales-count");
        const orderFormModal = document.getElementById("team-order-form-modal");
        const orderFormFrame = document.getElementById("team-order-form-frame");
        const orderFormModalTitle = document.getElementById("team-order-form-modal-title");
        const orderFormModalClose = document.getElementById("team-order-form-modal-close");
        const flowModal = document.getElementById("team-flow-modal");
        const flowTitle = document.getElementById("team-flow-title");
        const flowContent = document.getElementById("team-flow-content");
        let currentTeamSales = [];
        let currentSalesPage = 1;

        function formatMoney(value) {
            return Math.round(Number(value || 0)).toLocaleString("es-PY", { maximumFractionDigits: 0 });
        }

        function formatCommission(value) {
            return Math.round(Number(value || 0)).toLocaleString("es-PY", { minimumFractionDigits: 0, maximumFractionDigits: 0 });
        }

        function formatDate(value) {
            return value ? new Date(value).toLocaleDateString("es-PY") : "";
        }

        function escapeHtml(value) {
            return String(value ?? "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");
        }

        function setDefaultDates() {
            const today = new Date();
            const start = new Date(today.getFullYear(), today.getMonth(), 1);
            dateFrom.value = start.toISOString().slice(0, 10);
            dateTo.value = today.toISOString().slice(0, 10);
        }


        function sellerColorClass(value) {
            const text = String(value || "").trim().toLowerCase();
            let hash = 0;

            for (let index = 0; index < text.length; index += 1) {
                hash = ((hash << 5) - hash + text.charCodeAt(index)) | 0;
            }

            return `seller-color-${Math.abs(hash) % 7}`;
        }
        function renderSummary(items) {
            if (!items.length) {
                summaryChart.innerHTML = `<p class="empty-chart">Sin ventas para el periodo seleccionado</p>`;
                return;
            }

            const max = Math.max(...items.map(item => Number(item.totalVenta || 0)), 1);
            const totalCommission = items.reduce((sum, item) => sum + Number(item.totalComision || 0), 0);
            summaryChart.innerHTML = items.map(item => {
                const width = Math.max((Number(item.totalVenta || 0) / max) * 100, 4);
                return `
                    <div class="team-summary-row">
                        <span class="team-summary-seller">
                            <span class="orders-seller ${sellerColorClass(item.vendedor)}">${escapeHtml(item.vendedor)}</span>
                            <button type="button"
                                data-download-external-seller="${item.vendedorId}"
                                data-external-seller-name="${escapeHtml(item.vendedor)}"
                                title="Descargar detalle de ${escapeHtml(item.vendedor)}">PDF</button>
                        </span>
                        <div><i style="width:${width}%"></i></div>
                        <strong>
                            ${formatMoney(item.totalVenta)}
                            <small>Comision ${formatCommission(item.totalComision)}</small>
                        </strong>
                    </div>`;
            }).join("") + `
                <div class="team-summary-total">
                    <span>Total comision</span>
                    <strong>${formatCommission(totalCommission)}</strong>
                </div>`;
        }

        function renderSellerFilter(items, canFilter) {
            const sellers = items || [];
            const selected = sellerFilter.value;

            if (!sellers.length) {
                sellerFilter.innerHTML = `<option value="">Sin vendedores</option>`;
                sellerFilter.disabled = true;
                return;
            }

            const canSelectAll = Boolean(canFilter);
            sellerFilter.innerHTML = [
                canSelectAll ? `<option value="">Todos</option>` : "",
                ...sellers.map(item => `<option value="${item.vendedorId}">${escapeHtml(item.vendedor)}</option>`)
            ].join("");

            if (selected && sellers.some(item => String(item.vendedorId) === selected)) {
                sellerFilter.value = selected;
            } else if (!canSelectAll) {
                sellerFilter.value = String(sellers[0].vendedorId);
            } else {
                sellerFilter.value = "";
            }

            sellerFilter.disabled = !canFilter;
        }


        function teamSaleStatusClass(value) {
            const status = String(value || "").toLowerCase();
            if (status.includes("activo") || status.includes("entregado")) return "is-success";
            if (status.includes("pendiente") || status.includes("impres")) return "is-warning";
            if (status.includes("rechaz") || status.includes("elimin")) return "is-danger";
            return "is-info";
        }
        function detailStatusClass(status) {
            return String(status || "")
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "")
                .toLowerCase()
                .replace(/[^a-z0-9]+/g, "-")
                .replace(/^-|-$/g, "");
        }

        function detailStatesMarkup(details) {
            if (!details.length) {
                return `<span class="orders-detail-state-empty">Sin detalles</span>`;
            }

            return `<div class="orders-detail-states">${details.map(detail => {
                const label = detail.estadoItemNombre || detail.estadoItem || "Sin estado";
                return `<span class="orders-detail-state" title="${escapeHtml(detail.producto || `Item #${detail.detalleId}`)}: ${escapeHtml(label)}">
                    <span class="orders-detail-product">${escapeHtml(detail.producto || `Item #${detail.detalleId}`)}</span>
                    <span class="orders-status orders-detail-status ${detailStatusClass(label)}">${escapeHtml(label)}</span>
                </span>`;
            }).join("")}</div>`;
        }
        function renderSales(items) {
            currentTeamSales = items;
            currentSalesPage = 1;
            salesCount.textContent = `${items.length} ${items.length === 1 ? "venta encontrada" : "ventas encontradas"}`;
            renderSalesPage();
        }

        function renderSalesPage() {
            const pageSize = Number(pageSizeSelect.value || 10);
            const totalPages = Math.max(1, Math.ceil(currentTeamSales.length / pageSize));
            currentSalesPage = Math.min(Math.max(currentSalesPage, 1), totalPages);
            const start = (currentSalesPage - 1) * pageSize;
            const pageItems = currentTeamSales.slice(start, start + pageSize);
            const totalCommission = currentTeamSales.reduce((sum, item) => sum + Number(item.totalComision || 0), 0);

            salesBody.innerHTML = pageItems.length
                ? pageItems.map(item => `
                    <tr class="${item.reposicion ? "order-replacement-row" : ""}">
                        <td><strong class="team-sale-order">#${item.pedidoId}</strong></td>
                        <td>${formatDate(item.fecha)}</td>
                        <td><span class="orders-seller ${sellerColorClass(item.vendedor)}">${escapeHtml(item.vendedor)}</span></td>
                        <td class="orders-strong">${escapeHtml(item.cliente)}</td>
                        <td>${detailStatesMarkup(Array.isArray(item.detalles) ? item.detalles : [])}</td>
                        <td>${escapeHtml(item.usuarioEntrega || "-")}</td>
                        <td class="team-sale-money team-sale-total">${formatMoney(item.totalVenta)}</td>
                        <td class="team-sale-money team-sale-paid">${formatMoney(item.totalPagado)}</td>
                        <td class="team-sale-meters">${Number(item.totalMetros || 0).toLocaleString("es-PY", { maximumFractionDigits: 2 })}</td>
                        <td class="team-sale-money team-sale-commission">${formatCommission(item.totalComision)}</td>
                        <td class="orders-actions">
                            <div class="orders-actions-inner">
                                <button class="orders-edit" type="button" data-view-team-sale="${item.pedidoId}">Ver</button>
                                <button class="orders-edit order-flow-button" type="button" data-flow-team-sale="${item.pedidoId}">Flujo</button>
                            </div>
                        </td>
                    </tr>`).join("")
                : `<tr><td colspan="11">Sin ventas para el periodo seleccionado</td></tr>`;
            salesFoot.innerHTML = currentTeamSales.length
                ? `<tr>
                    <td colspan="9"><strong>Total comision</strong></td>
                    <td><strong>${formatCommission(totalCommission)}</strong></td>
                    <td></td>
                </tr>`
                : "";
            pageInfo.textContent = `Pagina ${currentSalesPage} de ${totalPages}`;
            pageNumber.textContent = currentSalesPage;
            prevPageButton.disabled = currentSalesPage <= 1;
            nextPageButton.disabled = currentSalesPage >= totalPages;
        }

        function formatFlowDate(value) {
            if (!value) return "-";
            const date = new Date(value);
            return Number.isNaN(date.getTime()) ? "-" : date.toLocaleString("es-PY", { dateStyle: "short", timeStyle: "medium" });
        }

        function closeOrderFlow() {
            flowModal.hidden = true;
            flowContent.innerHTML = "";
        }

        async function openOrderFlow(orderId) {
            flowTitle.textContent = `Flujo del pedido #${orderId}`;
            flowContent.innerHTML = `<div class="empty-state">Cargando historial...</div>`;
            flowModal.hidden = false;
            const response = await fetch(`/api/pedidos/${orderId}/flujo`);
            if (!response.ok) {
                const error = await response.json().catch(() => null);
                flowContent.innerHTML = `<div class="empty-state">${escapeHtml(error?.message || "No se pudo cargar el flujo del pedido.")}</div>`;
                return;
            }
            const events = await response.json() || [];
            flowContent.innerHTML = events.length ? events.map(event => `
                <article class="order-flow-event">
                    <span class="order-flow-dot" aria-hidden="true"></span>
                    <div class="order-flow-event-card">
                        <div class="order-flow-event-heading"><strong>${escapeHtml(event.accion)}</strong><time>${escapeHtml(formatFlowDate(event.fechaHora))}</time></div>
                        <p><b>Usuario:</b> ${escapeHtml(event.usuario || "Sistema")}</p>
                        <p><b>Estado:</b> ${escapeHtml(event.estadoAnterior || "Sin estado")} → ${escapeHtml(event.estadoNuevo || "Sin estado")}</p>
                        ${event.detalleId ? `<p><b>Detalle:</b> #${escapeHtml(event.detalleId)}</p>` : ""}
                        ${event.producto ? `<p><b>Producto:</b> ${escapeHtml(event.producto)}</p>` : ""}
                        ${event.comentario ? `<div class="order-flow-comment"><b>Comentario:</b> ${escapeHtml(event.comentario)}</div>` : ""}
                    </div>
                </article>`).join("") : `<div class="empty-state">Este pedido todavía no tiene eventos registrados.</div>`;
        }
        async function downloadExternalSellerPdf(sellerId, sellerName) {
            await withAppLoading("Preparando PDF...", async function () {
                const params = new URLSearchParams();
                if (dateFrom.value) params.set("dateFrom", dateFrom.value);
                if (dateTo.value) params.set("dateTo", dateTo.value);
                params.set("scope", "externos");
                params.set("vendedorExternoId", sellerId);

                const response = await fetch(`/api/reportes/comisiones-vendedores/pdf?${params}`);
                if (!response.ok) {
                    const error = await response.json().catch(() => null);
                    showToast(error?.message || "No se pudo preparar el PDF.", "error");
                    return;
                }

                const blob = await response.blob();
                const link = document.createElement("a");
                link.href = URL.createObjectURL(blob);
                const safeName = String(sellerName || "vendedor-externo")
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "")
                    .replace(/[^a-zA-Z0-9]+/g, "-")
                    .replace(/^-|-$/g, "")
                    .toLowerCase();
                link.download = `${safeName || "vendedor-externo"}-${dateFrom.value}-${dateTo.value}.pdf`;
                document.body.appendChild(link);
                link.click();
                link.remove();
                URL.revokeObjectURL(link.href);
            });
        }


        function openOrder(orderId) {
            orderFormModalTitle.textContent = `Pedido ${orderId}`;
            orderFormFrame.src = `${window.appUrl("/pedidos/formulario")}?id=${encodeURIComponent(orderId)}&embedded=1`;
            orderFormModal.hidden = false;
            document.body.classList.add("is-order-modal-open");
            orderFormModalClose.focus();
        }

        function closeOrderModal(shouldRefresh = false) {
            orderFormModal.hidden = true;
            orderFormFrame.src = "about:blank";
            document.body.classList.remove("is-order-modal-open");

            if (shouldRefresh) {
                loadTeamSales();
            }
        }
        async function downloadSalesExcel() {
            if (!currentTeamSales.length) {
                showToast("No hay ventas para exportar.", "error");
                return;
            }

            await withAppLoading("Preparando Excel...", async function () {
                const params = new URLSearchParams();
                if (dateFrom.value) params.set("dateFrom", dateFrom.value);
                if (dateTo.value) params.set("dateTo", dateTo.value);
                if (sellerFilter.value) params.set("vendedorId", sellerFilter.value);
                if (clientFilter.value) params.set("clienteId", clientFilter.value);
            if (paymentStatusFilter.value) params.set("estadoPagoId", paymentStatusFilter.value);
                const response = await fetch(`/api/grupo-ventas/mi-equipo/excel?${params}`);
                if (!response.ok) {
                    showToast("No se pudo preparar el Excel.", "error");
                    return;
                }

                const blob = await response.blob();
                const link = document.createElement("a");
                link.href = URL.createObjectURL(blob);
                link.download = `grupo-ventas-${dateFrom.value || "desde"}-${dateTo.value || "hasta"}.xlsx`;
                document.body.appendChild(link);
                link.click();
                link.remove();
                URL.revokeObjectURL(link.href);
            });
        }

        async function loadFilterOptions() {
            const response = await fetch("/api/pedidos/opciones");
            if (!response.ok) {
                showToast("No se pudieron cargar los filtros de clientes y estados de pago.", "error");
                return;
            }

            const options = await response.json();
            clientFilter.innerHTML = '<option value="">Todos</option>' + (options.clientes || [])
                .map(item => '<option value="' + item.id + '">' + escapeHtml(item.nombre || ('Cliente ' + item.id)) + '</option>')
                .join("");
            paymentStatusFilter.innerHTML = '<option value="">Todos</option>' + (options.estadosPago || [])
                .map(item => '<option value="' + escapeHtml(item.id) + '">' + escapeHtml(item.nombre || item.id) + '</option>')
                .join("");
        }
        async function loadTeamSales() {
            if (!dateFrom.value || !dateTo.value) {
                setDefaultDates();
            }

            const params = new URLSearchParams();
            if (dateFrom.value) params.set("dateFrom", dateFrom.value);
            if (dateTo.value) params.set("dateTo", dateTo.value);
            if (sellerFilter.value) params.set("vendedorId", sellerFilter.value);
            if (clientFilter.value) params.set("clienteId", clientFilter.value);
            if (paymentStatusFilter.value) params.set("estadoPagoId", paymentStatusFilter.value);

            const response = await fetch(`/api/grupo-ventas/mi-equipo?${params}`);
            if (!response.ok) {
                showToast("No se pudo cargar el grupo de ventas.", "error");
                return;
            }

            const data = await response.json();
            renderSellerFilter(data.vendedores || [], data.puedeFiltrarVendedores);
            renderSummary(data.resumen || []);
            renderSales(data.ventas || []);
        }

        document.querySelectorAll(".team-sales-tabs button").forEach(button => {
            button.addEventListener("click", () => {
                document.querySelectorAll(".team-sales-tabs button").forEach(item => item.classList.remove("active"));
                button.classList.add("active");
                document.getElementById("team-summary-tab").hidden = button.dataset.tab !== "summary";
                document.getElementById("team-sales-tab").hidden = button.dataset.tab !== "sales";
            });
        });

        summaryChart.addEventListener("click", event => {
            const button = event.target.closest("[data-download-external-seller]");
            if (!button) {
                return;
            }

            downloadExternalSellerPdf(
                button.dataset.downloadExternalSeller,
                button.dataset.externalSellerName);
        });


        salesBody.addEventListener("click", event => {
            const viewButton = event.target.closest("[data-view-team-sale]");
            if (viewButton) {
                openOrder(viewButton.dataset.viewTeamSale);
                return;
            }

            const flowButton = event.target.closest("[data-flow-team-sale]");
            if (flowButton) {
                openOrderFlow(flowButton.dataset.flowTeamSale);
            }
        });

        document.getElementById("team-flow-close").addEventListener("click", closeOrderFlow);
        document.getElementById("team-flow-close-footer").addEventListener("click", closeOrderFlow);
        flowModal.addEventListener("click", event => {
            if (event.target === flowModal) closeOrderFlow();
        });

        orderFormModalClose.addEventListener("click", () => closeOrderModal());
        orderFormModal.addEventListener("click", event => {
            if (event.target.closest("[data-team-order-modal-close]")) {
                closeOrderModal();
            }
        });

        window.addEventListener("message", event => {
            if (event.origin !== window.location.origin) {
                return;
            }

            if (event.data?.type === "order-modal-close") {
                closeOrderModal();
            } else if (event.data?.type === "order-modal-updated") {
                loadTeamSales();
            } else if (event.data?.type === "order-modal-saved") {
                closeOrderModal(true);
            }
        });

        document.addEventListener("keydown", event => {
            if (event.key !== "Escape") return;
            if (!flowModal.hidden) {
                closeOrderFlow();
            } else if (!orderFormModal.hidden) {
                closeOrderModal();
            }
        });
        dateFrom.addEventListener("change", loadTeamSales);
        dateTo.addEventListener("change", loadTeamSales);
        sellerFilter.addEventListener("change", loadTeamSales);
        clientFilter.addEventListener("change", loadTeamSales);
        paymentStatusFilter.addEventListener("change", loadTeamSales);
        downloadExcelButton.addEventListener("click", downloadSalesExcel);
        pageSizeSelect.addEventListener("change", function () {
            currentSalesPage = 1;
            renderSalesPage();
        });
        prevPageButton.addEventListener("click", function () {
            currentSalesPage -= 1;
            renderSalesPage();
        });
        nextPageButton.addEventListener("click", function () {
            currentSalesPage += 1;
            renderSalesPage();
        });
        setDefaultDates();
        loadFilterOptions().then(loadTeamSales);
    </script>
}
